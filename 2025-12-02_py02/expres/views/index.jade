doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Jade Collection
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #0a4d3c 0%, #1a6b54 25%, #2d8b6e 50%, #0f3d2f 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        position: relative;
      }
      
      body::before {
        content: '';
        position: absolute;
        width: 150%;
        height: 150%;
        background: radial-gradient(circle at 20% 50%, rgba(61, 255, 191, 0.1) 0%, transparent 50%),
                    radial-gradient(circle at 80% 50%, rgba(34, 139, 87, 0.15) 0%, transparent 50%);
        animation: pulse 8s ease-in-out infinite;
      }
      
      @keyframes pulse {
        0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.6; }
        50% { transform: scale(1.1) rotate(5deg); opacity: 0.8; }
      }
      
      .container {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 60px 40px;
        max-width: 900px;
        width: 90%;
      }
      
      h1 {
        color: #d4f4e7;
        font-size: 3.5em;
        font-weight: 300;
        letter-spacing: 8px;
        margin-bottom: 20px;
        text-transform: uppercase;
        text-shadow: 0 0 30px rgba(61, 255, 191, 0.5),
                     0 0 60px rgba(34, 139, 87, 0.3);
        animation: glow 3s ease-in-out infinite alternate;
      }
      
      @keyframes glow {
        from { text-shadow: 0 0 20px rgba(61, 255, 191, 0.4), 0 0 40px rgba(34, 139, 87, 0.2); }
        to { text-shadow: 0 0 30px rgba(61, 255, 191, 0.7), 0 0 60px rgba(34, 139, 87, 0.4); }
      }
      
      .subtitle {
        color: #a8e6cf;
        font-size: 1.2em;
        font-weight: 300;
        letter-spacing: 3px;
        margin-bottom: 60px;
        opacity: 0.9;
      }
      
      .cards-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 30px;
        margin-top: 40px;
      }
      
      .card {
        background: linear-gradient(135deg, rgba(61, 255, 191, 0.15) 0%, rgba(34, 139, 87, 0.25) 100%);
        backdrop-filter: blur(20px);
        border: 2px solid rgba(61, 255, 191, 0.3);
        border-radius: 20px;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }
      
      .card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(61, 255, 191, 0.15) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.5s ease;
      }
      
      .card:hover {
        transform: translateY(-15px) scale(1.05);
        border-color: rgba(61, 255, 191, 0.6);
        box-shadow: 0 20px 60px rgba(61, 255, 191, 0.4),
                    inset 0 1px 0 rgba(255, 255, 255, 0.2);
      }
      
      .card:hover::before {
        opacity: 1;
        animation: rotate 4s linear infinite;
      }
      
      @keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      
      .card-number {
        position: absolute;
        top: 15px;
        right: 20px;
        color: rgba(61, 255, 191, 0.4);
        font-size: 3em;
        font-weight: 700;
        line-height: 1;
      }
      
      .card-name {
        position: relative;
        z-index: 1;
        color: #d4f4e7;
        font-size: 1.8em;
        font-weight: 500;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-top: 20px;
      }
      
      .gem {
        width: 60px;
        height: 60px;
        margin: 0 auto 20px;
        background: linear-gradient(135deg, #3dffbf 0%, #228b57 100%);
        clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
        animation: spin 6s linear infinite;
        filter: drop-shadow(0 0 20px rgba(61, 255, 191, 0.6));
      }
      
      @keyframes spin {
        from { transform: rotateY(0deg); }
        to { transform: rotateY(360deg); }
      }
      
      .card:hover .gem {
        animation: spin 2s linear infinite;
      }

  body
    .container
      h1 Jade Collection
      .subtitle Precious Gemstones
      
      .cards-container
        if samp
          each name, index in samp
            .card
              .card-number= index + 1
              .gem
              .card-name= name
